{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Capability for the Settings window and the menu bar panel",
  "windows": ["settings", "macro11-panel"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit-to",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging"
  ]
}
